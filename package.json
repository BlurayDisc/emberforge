{
  "name": "emberforge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "balance": "tsx tools/balance-sim/run.ts",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tools && tsx tools/check-boundaries.ts && tsx tools/validate-data.ts",
    "validate": "tsx tools/validate-data.ts"
  },
  "dependencies": {
    "@fontsource/jacquard-12": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
