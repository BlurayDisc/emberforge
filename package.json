{
  "name": "emberforge",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "balance": "tsx tools/balance-sim/run.ts",
    "scenarios": "tsx tools/balance-sim/scenarios.ts",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tools && tsx tools/check-boundaries.ts && tsx tools/validate-data.ts && tsx tools/smoke-play.ts && npm run check:realtime",
    "validate": "tsx tools/validate-data.ts",
    "smoke": "tsx tools/smoke-play.ts",
    "gallery": "vite --open /spell-gallery.html",
    "story-gallery": "vite --open /story-gallery.html",
    "battlesim": "vite --open /battle-sim.html",
    "sprites": "tsx tools/headless-art/sprites.ts",
    "animation": "tsx tools/headless-art/animation.ts",
    "icons": "tsx tools/make-app-icons.ts",
    "shot": "tsx tools/headless-browser/shot.ts",
    "check:realtime": "tsx tools/check-realtime-battle.ts",
    "timeline:realtime": "tsx tools/balance-sim/realtime-timeline.ts",
    "audio-report": "tsx tools/audio-report.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "@fontsource/jacquard-12": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "pixi.js": "^8.22.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
